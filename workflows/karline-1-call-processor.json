    {
      "parameters": {
        "promptType": "define",
        "text": "=Call transcript:\n{{ $json.text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You classify customer calls for Karline Bakery, a cake shop with delivery.\nRead the call transcript and return two labels.\n\nIgnore completely:\n- automated system messages, especially at the start of the recording\n  (for example, a phone provider's trial-account notice like\n  \"You have a trial account... press any key\"). They are not part of the conversation.\n- the operator's politeness and apologies.\n\nsentiment = the CUSTOMER's overall attitude:\n- positive: the customer is satisfied, thanks or praises\n- negative: the customer complains, is angry or disappointed\n- neutral: a question or info request, or mixed feedback without a real complaint.\n  Praise combined with a personal taste preference\n  (\"too sweet for me\", \"next time I'll try something else\") is neutral, not negative.\n\ncategory = the main topic of the call:\n- cake_quality: taste, freshness, appearance, decoration, ingredients\n- delivery_quality: lateness, courier behavior, condition of the cake on arrival\n- other: anything else (payments, opening hours, pickup, prices)\n\nRules:\n- If the call has several topics, choose the one the customer cares about most.\n- If unsure, choose neutral / other.\n- Return only the JSON. No explanations."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
