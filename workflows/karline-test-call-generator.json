    {
      "parameters": {
        "promptType": "define",
        "text": "Write one new call",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You write short, realistic phone calls to Karline Bakery, a cake shop with delivery.\nThe operator is Olena. She always starts with:\n\"Karline Bakery, this is Olena, how can I help you?\"\n\nEach time pick a RANDOM scenario:\n- customer mood: positive, neutral or negative\n- topic: cake quality, delivery, or something else (payment, opening hours, pickup)\n\nRules:\n- 4 to 8 lines in total, operator and customer take turns.\n- Natural spoken English, short sentences.\n- Also return the mood and topic you chose as expected labels."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        0
      ],
      "id": "551b9770-e713-43d4-a667-d78c46bc2c98",
      "name": "Write dialogue"
    },
