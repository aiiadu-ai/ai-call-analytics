        "model": "nvidia/nemotron-3-super-120b-a12b:free",
        "options": {
          "temperature": 0.9
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        176,
        224
      ],
      "id": "62a7d408-56ea-4a6c-b246-972df8e067c4",
      "name": "AI model",
      "credentials": {
        "openRouterApi": {
          "id": "",
          "name": "OpenRouter account 2"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"expected_sentiment\": { \"type\": \"string\", \"enum\": [\"positive\", \"neutral\", \"negative\"] },\n    \"expected_category\": { \"type\": \"string\", \"enum\": [\"cake_quality\", \"delivery_quality\", \"other\"] },\n    \"lines\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"speaker\": { \"type\": \"string\", \"enum\": [\"operator\", \"customer\"] },\n          \"text\": { \"type\": \"string\" }\n        },\n        \"required\": [\"speaker\", \"text\"]\n      }\n    }\n  },\n  \"required\": [\"expected_sentiment\", \"expected_category\", \"lines\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        352,
        224
      ],
      "id": "7b2492e0-26cd-4b90-8b1f-f0514768b089",
      "name": "Strict answer format"
    },
    {
      "parameters": {
        "jsCode": "const { lines, expected_sentiment, expected_category } = $json.output;\n\n// ElevenLabs voice IDs for the two roles\nconst voices = {\n  operator: 'cgSgspJ2msm6clMCkdW9',\n  customer: 'IKne3meq5aSn9XLyUdCD'\n};\n\nconst inputs = lines.map(l => ({ text: l.text, voice_id: voices[l.speaker] }));\n\nreturn [{ json: { inputs, expected_sentiment, expected_category } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        0
      ],
      "id": "2b2fad25-5e2a-49fc-a781-7829e2b07e4c",
