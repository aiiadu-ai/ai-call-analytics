      "name": "Calls in period",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// keep only real rows (Always Output Data adds an empty item when the period has no calls)\nconst rows = $input.all().map(i => i.json).filter(r => r.sentiment);\n\nconst totalCalls = rows.length;\nconst negativeCalls = rows.filter(r => r.sentiment === 'negative').length;\nconst positiveCalls = rows.filter(r => r.sentiment === 'positive').length;\nconst neutralCalls = rows.filter(r => r.sentiment === 'neutral').length;\n\n// no division by zero when there were no calls\nconst percent = totalCalls === 0 ? 0 : Math.round(negativeCalls / totalCalls * 100);\n\nreturn [{\n  json: {\n    totalCalls,\n    negativeCalls,\n    negativeCallPercent: `${percent}%`,\n    positiveCalls,\n    neutralCalls\n  }\n}];"
      },
